# Copy this file to `.env` for local development and fill in real values.
# NEVER commit the real `.env` (it is in .gitignore).
# In production, set these as environment variables in the Render dashboard.

# The single Anthropic key the proxy uses for all calls. Server-side only.
ANTHROPIC_API_KEY=sk-ant-...

# Shared access token pilot users must send (header: x-access-token).
# Choose a long random string, e.g. `openssl rand -hex 24`.
PROXY_ACCESS_TOKEN=replace-with-a-long-random-string

# Cumulative USD spend cap (soft early cutoff — see README LIMITATIONS).
PROXY_BUDGET_USD=50

# The frontend origin(s) allowed to call this proxy. Comma-separated.
# Example for GitHub Pages:
PROXY_ALLOWED_ORIGINS=https://guyaros.github.io
